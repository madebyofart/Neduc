<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #C15854, #E9B376);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.neduc.neduc.ResetPasswordController">

    <left>
        <VBox alignment="CENTER_LEFT" prefHeight="650.0" prefWidth="450.0" spacing="20" style="-fx-padding: 50;">
            
            <Label style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: white;" text="Réinitialiser votre mot de passe" />

            <TextField fx:id="idField" promptText="Entrez votre ID" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 0 0 1 0; -fx-text-fill: white; -fx-prompt-text-fill: derive(white, -30%); -fx-font-size: 14px; -fx-padding: 5 0 5 0;" />

            <TextField fx:id="emailField" promptText="Entrez votre adresse email" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 0 0 1 0; -fx-text-fill: white; -fx-prompt-text-fill: derive(white, -30%); -fx-font-size: 14px; -fx-padding: 5 0 5 0;" />

            <!-- Label pour afficher les erreurs -->
            <Label fx:id="errorLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: red;" />

            <Button onAction="#handleReset" style="-fx-background-color: #4B2828; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 5;" text="Envoyer le lien de réinitialisation" />

            <Hyperlink onAction="#handleBack" style="-fx-text-fill: black; -fx-underline: true;" text="← Retour à la connexion" />

            <padding>
                <Insets right="10.0" />
            </padding>
        </VBox>
    </left>

    <center>
        <ImageView fx:id="myGif" fitHeight="500" fitWidth="500" preserveRatio="true" />
    </center>
   <padding>
      <Insets right="20.0" />
   </padding>
</BorderPane>
