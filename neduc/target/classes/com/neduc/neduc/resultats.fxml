<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.neduc.neduc.ResultatsController">

    <top>
        <Label text="Gestion des Résultats" style="-fx-font-size: 18px; -fx-font-weight: bold;" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <TabPane fx:id="tabPane">
            <tabs>
                <Tab text="Relevés Collectifs" closable="false">
                    <fx:include source="releves.fxml"/>
                </Tab>
                <Tab text="Bulletins Individuels" closable="false">
                    <fx:include source="bulletins.fxml"/>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
