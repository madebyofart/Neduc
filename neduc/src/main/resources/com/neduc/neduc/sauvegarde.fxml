<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.neduc.neduc.SauvegardeController" style="-fx-padding: 10;">
    
    <!-- Zone centrale : console de sauvegarde -->
    <center>
        <TextArea fx:id="consoleTextArea" prefHeight="200" prefWidth="600" wrapText="true" editable="false" 
                  style="-fx-font-family: 'Courier New'; -fx-font-size: 14px;" />
    </center>
    
    <!-- Zone inférieure : boutons -->
    <bottom>
        <HBox spacing="20" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
            <Button fx:id="btnSauvegarder" text="Sauvegarder la Base de Données" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button fx:id="btnRestaurer" text="Restaurer la Base de Données" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
        </HBox>
    </bottom>

</BorderPane>
