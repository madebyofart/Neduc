<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #C15854, #E9B376);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.neduc.neduc.DashboardController">
    
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="128.0" spacing="20" style="-fx-background-color: #1e293b; -fx-padding: 30 0 0 0;">
            <Label style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;" text="Néduc" />
            <Button prefHeight="45.0" prefWidth="128.0" style="-fx-background-color: white; -fx-text-fill: black; -fx-font-size: 16px; -fx-padding: 10 20; -fx-alignment: CENTER_LEFT;" text="Dashboard" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 16px; -fx-padding: 10 20; -fx-alignment: CENTER_LEFT;" text="Utilisateurs" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 16px; -fx-padding: 10 20; -fx-alignment: CENTER_LEFT;" text="Étudiants" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #e2e8f0; -fx-font-size: 16px; -fx-padding: 10 20; -fx-alignment: CENTER_LEFT;" text="Paramètres" />
        </VBox>
    </left>

    <center>
        <VBox prefHeight="650.0" prefWidth="719.0" spacing="20">
            <Label prefHeight="40.0" prefWidth="242.0" style="-fx-font-size: 28px; -fx-text-fill: #1f2937; -fx-font-weight: bold;" text="Tableau de bord">
            <VBox.margin>
               <Insets left="20.0" top="22.0" />
            </VBox.margin></Label>
            <HBox prefHeight="206.0" prefWidth="1072.0" spacing="20">
                
                <VBox alignment="CENTER" prefHeight="124.0" prefWidth="337.0" spacing="10" style="-fx-background-color: white; -fx-border-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Utilisateurs" />
                    <Label fx:id="userCountLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="123" />
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
                </VBox>

                <VBox alignment="CENTER" prefHeight="100" prefWidth="345.0" spacing="10" style="-fx-background-color: white; -fx-border-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Étudiants" />
                    <Label fx:id="studentCountLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="456" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="100" prefWidth="345.0" spacing="10" style="-fx-background-color: white; -fx-border-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Matières" />
                    <Label fx:id="subjectCountLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="34" />
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>
